# Application Configuration
APP_NAME=PiBlindHub
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Database Configuration
DATABASE_URL=sqlite:///data/store_manager.db
DATABASE_ECHO=false

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Admin Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-before-use

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=piblindhub
MQTT_KEEPALIVE=60

# SSL/TLS Configuration (for MQTT)
MQTT_SSL_ENABLED=false
MQTT_CA_CERT=
MQTT_CLIENT_KEY=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Device Configuration
DEVICE_DEFAULT_ID=webapp
DEVICE_TIMEOUT=30
DEVICE_RETRY_ATTEMPTS=3

# API Configuration
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_RATE_LIMIT_BURST_SIZE=10

# CORS Configuration
CORS_ORIGINS=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=*

# Session Configuration
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=300

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=json,xml,csv

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@storemanager.local

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
METRICS_PORT=9090

# Hotspot Configuration
HOTSPOT_ENABLED=true
HOTSPOT_DEFAULT_PORT=15001
HOTSPOT_PASSWORD=change-me-before-use
HOTSPOT_CHANNEL=7
HOTSPOT_DHCP_RANGE_START=2
HOTSPOT_DHCP_RANGE_END=254
HOTSPOT_AUTO_START_ON_NO_WIFI=true
