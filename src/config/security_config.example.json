{
  "authentication": {
    "default_username": "admin",
    "default_password": "change-me-before-use",
    "password_reset_required": true,
    "jwt_secret": "generate-a-long-random-secret",
    "jwt_expiration": 3600,
    "refresh_token_expiration": 86400,
    "admin_password_hash": "",
    "password_changed_at": null
  },
  "password_policy": {
    "min_length": 8,
    "require_uppercase": true,
    "require_lowercase": true,
    "require_numbers": true,
    "require_special_chars": true,
    "max_age_days": 90
  },
  "api_keys": {
    "default_expiration_days": 365,
    "max_keys_per_user": 10,
    "key_length": 32
  },
  "encryption": {
    "algorithm": "AES-256-GCM",
    "key_derivation": "PBKDF2",
    "iterations": 100000
  },
  "security_headers": {
    "hsts": true,
    "content_type_options": true,
    "frame_options": "DENY",
    "xss_protection": true
  },
  "rate_limiting": {
    "login_attempts": {
      "max_attempts": 5,
      "window_minutes": 15,
      "lockout_minutes": 30
    },
    "api_requests": {
      "max_requests": 100,
      "window_minutes": 1
    }
  }
}

