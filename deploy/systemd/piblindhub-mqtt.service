[Unit]
Description=PiBlindHub optional MQTT adapter
Documentation=https://github.com/capisoft-lib/PiBlindHub
After=network-online.target piblindhub-control.service
Wants=network-online.target
Requires=piblindhub-control.service

[Service]
Type=simple
User=piblindhub-web
Group=piblindhub-ipc
Environment=PIBLINDHUB_CONFIG=/etc/piblindhub/config.json
EnvironmentFile=/etc/piblindhub/piblindhub.env
ExecStart=/opt/piblindhub/venv/bin/piblindhub-mqtt
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
